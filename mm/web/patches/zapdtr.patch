diff --git a/ZAPD/CMakeLists.txt b/ZAPD/CMakeLists.txt
index 91b88df..6f99cf4 100644
--- a/ZAPD/CMakeLists.txt
+++ b/ZAPD/CMakeLists.txt
@@ -372,10 +372,12 @@ if ("${CMAKE_CXX_COMPILER_ID}" MATCHES "GNU|Clang|AppleClang")
         -Wno-parentheses
         -Wno-narrowing
         $<$<COMPILE_LANGUAGE:CXX>:-Wno-deprecated-enum-enum-conversion>
-		-pthread
+		$<$<NOT:$<BOOL:${EMSCRIPTEN}>>:-pthread>
 	)
 
-    if (CMAKE_SYSTEM_NAME STREQUAL "Darwin")
+    if (EMSCRIPTEN)
+        # The web build has no threads (-pthread would require shared memory for the whole page).
+    elseif (CMAKE_SYSTEM_NAME STREQUAL "Darwin")
         target_link_options(${PROJECT_NAME} PUBLIC
             -pthread
         )
@@ -428,6 +430,13 @@ elseif(CMAKE_SYSTEM_NAME STREQUAL "CafeOS")
         "libultraship;"
         PNG::PNG
     )
+elseif(EMSCRIPTEN)
+	set(ADDITIONAL_LIBRARY_DEPENDENCIES
+		-Wl,--whole-archive $<TARGET_LINKER_FILE_DIR:OTRExporter>/$<TARGET_LINKER_FILE_NAME:OTRExporter> -Wl,--no-whole-archive
+		"libultraship;"
+		PNG::PNG
+		${CMAKE_DL_LIBS}
+	)
 else()
 	set(THREADS_PREFER_PTHREAD_FLAG ON)
 	find_package(Threads REQUIRED)
