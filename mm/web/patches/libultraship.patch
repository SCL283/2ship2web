+    if (!Module.lusRefreshRate) {
+        const state = Module.lusRefreshRate = { rate: 0, last: 0, intervals: [] };
+        const tick = (now) => {
+            if (state.last) {
+                state.intervals.push(now - state.last);
+                if (state.intervals.length > 60) {
+                    state.intervals.shift();
